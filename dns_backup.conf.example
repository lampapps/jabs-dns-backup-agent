# =============================================================================
# dns_backup.conf — Configuration for dns_backup.sh
#
# Copy to /etc/dns_backup.conf on your WORKSTATION and set permissions:
#   sudo cp dns_backup.conf.example /etc/dns_backup.conf
#   sudo chmod 600 /etc/dns_backup.conf
#   sudo chown root:root /etc/dns_backup.conf
# =============================================================================

# Reported on the host record; bump when you change this script.
JABS_AGENT_VERSION="0.1.0"

# Hostnames or IPs of your two DNS nodes
DNS1_HOST="10.10.1.2"
DNS2_HOST="10.10.1.3"

# ── JABS agent monitoring (optional) ──────────────────────────────────────
# Reports each node's imaging run as a job to a JABS dashboard, via
# jabs_client.py (a small stdlib-only Python HTTP client — requires
# python3, no pip install needed). Set JABS_SERVER_URL="" (or leave unset)
# to disable — everything below is then ignored.
#
# IMPORTANT: register this agent on the JABS dashboard's Agents page first —
# there is no self-registration API. Registering returns a unique API key;
# paste it into JABS_AGENT_KEY below.
JABS_SERVER_URL="http://10.10.2.10:5000"

# API key for this agent, generated when you register it on the dashboard.
JABS_AGENT_KEY=""

# NAS mount point (must be mounted and writable on your workstation)
NAS_MOUNT="/mnt/nas-unas"

# Base directory for image files
# Images are written to: BACKUP_BASE_DIR/<node>/sd_image_<timestamp>.img.gz
BACKUP_BASE_DIR="/mnt/nas-unas/backups"

#── Uncomment below to override defaults as needed. ──────────────────────────────────────

# Days to retain old image files (0 = keep forever)
#IMAGE_RETENTION_DAYS=90

# Per-request timeout (seconds) for calls to the JABS dashboard.
#JABS_TIMEOUT=10

# SSH user on the RPi nodes
#SSH_USER="pi"

# Block device for the built-in SD card slot on RPi4 (rarely needs changing)
#SD_DEVICE="/dev/mmcblk0"

# Services to stop before imaging, in stop order.
# keepalived MUST be first so the VIP fails over to the peer immediately.
# Services are restarted in reverse order after imaging.
#STOP_SERVICES="keepalived dns caddy"

# Seconds to wait after stopping keepalived before imaging starts.
# Allows the peer node to claim the VIP before we read the card.
#FAILOVER_WAIT=20

# Seconds to wait after restarting a node before imaging the peer.
# Allows keepalived to reclaim the VIP and the node to fully rejoin.
#REJOIN_WAIT=30

